# For an instantiated project, or the root of a repo holding several papers.
# Unanchored so the per-paper directories are covered too.
.pixi/
site/
screenshots/
__pycache__/
*.pyc
.DS_Store
.env

# Full-page probe renders are scratch output, regenerated on demand.
**/docs/assets/img/figures/pages/

# Papers are usually not redistributable. Cropped figures are committed, so the
# site still builds where the PDF is absent.
*.pdf
